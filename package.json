{
  "name": "personal-ai-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,worker -c blue,green \"npm:dev:client\" \"npm:dev:worker\"",
    "dev:client": "vite build --watch",
    "dev:worker": "wrangler dev --config wrangler.dev.jsonc",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply personal-ai-hub-db --local --config wrangler.dev.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply personal-ai-hub-db --remote",
    "db:seed:local": "wrangler d1 execute personal-ai-hub-db --local --file=scripts/seed.sql --config wrangler.dev.jsonc",
    "db:seed:remote": "wrangler d1 execute personal-ai-hub-db --remote --file=scripts/seed.sql"
  },
  "dependencies": {
    "@types/three": "^0.186.0",
    "dompurify": "^3.4.16",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4",
    "marked": "^18.0.14",
    "react": "^19",
    "react-dom": "^19",
    "react-router-dom": "^7",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "@tailwindcss/vite": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4",
    "concurrently": "^9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^6",
    "vitest": "^3",
    "wrangler": "^4"
  }
}
